# Скопируйте в backend/.env и заполните нужное. Все LLM-провайдеры необязательны —
# без них работают анализ, rule-based оптимизация, EXPLAIN, сравнение и бенчмарк.

# Хранилище результатов (по умолчанию SQLite в backend/data/optimizer.db)
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/aidbo

# Модель по умолчанию (id из GET /api/models), напр. gigachat:GigaChat-2-Max
# DEFAULT_MODEL=

# --- GigaChat (Сбер): developers.sber.ru → проект GigaChat API → «Authorization key»
# GIGACHAT_AUTH_KEY=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS          # для юрлиц: GIGACHAT_API_B2B / GIGACHAT_API_CORP
# GIGACHAT_MODELS=GigaChat-2,GigaChat-2-Pro,GigaChat-2-Max
# Сертификат НУЦ Минцифры (https://www.gosuslugi.ru/crt) либо отключение проверки:
# GIGACHAT_CA_BUNDLE=config/russian_trusted_root_ca.pem   # корневой сертификат Минцифры (gu-st.ru), лежит в репозитории
# GIGACHAT_VERIFY_SSL=true

# --- YandexGPT (Yandex Cloud): сервисный аккаунт с ролью ai.languageModels.user + API-ключ
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=
# YANDEX_MODELS=yandexgpt/latest,yandexgpt-lite/latest

# --- Ollama (локальные модели, нативный API: задаётся контекст и JSON-режим)
# Модели нужен запас свободной ОЗУ: ~10 ГБ для 16B Q4, ~5 ГБ для 7B Q4. При нехватке памяти ответ идёт десятки минут.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODELS=qwen2.5-coder:7b
# OLLAMA_NUM_CTX=8192
# OLLAMA_NUM_PREDICT=1500
# LLM_TIMEOUT_S=900

# --- Любой OpenAI-совместимый API: DeepSeek, OpenRouter, Ollama, LM Studio, vLLM …
# DeepSeek:  OPENAI_BASE_URL=https://api.deepseek.com/v1   OPENAI_MODELS=deepseek-chat
# Ollama:    OPENAI_BASE_URL=http://localhost:11434/v1     OPENAI_MODELS=qwen2.5-coder:14b  (ключ не нужен)
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODELS=
# OPENAI_PROVIDER_NAME=deepseek

# LLM_TEMPERATURE=0.1
# QUERY_TIMEOUT_MS=30000
# BENCHMARK_WARMUP=2
# BENCHMARK_RUNS=5
